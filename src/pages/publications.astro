---
import Layout from "../layouts/Layout.astro";
import { getSortedPublications, getVisiblePublications, type Publication } from "../utils/publications";
import publicationsData from "../data/publications.yaml";

const publications = getSortedPublications(
    getVisiblePublications(publicationsData as Publication[])
);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const resolveBaseHref = (href?: string) =>
    href
        ? href.startsWith("/")
            ? `${baseUrl}/${href.replace(/^\//, "")}`
            : href
        : null;

const publicationsJson = JSON.stringify(
    publications.map((publication) => ({
        ...publication,
        pdf: resolveBaseHref(publication.pdf),
        website: resolveBaseHref(publication.website),
    }))
);
---

<Layout title="Publications - VIOS Collaboratory">
    <section class="page-header">
        <div class="s-head">
            <div class="s-eyebrow">
                <div class="s-eyebrow-line"></div>
                <span class="s-eyebrow-text">Our Output</span>
            </div>
            <h1 class="s-title">Latest <em>publications</em></h1>
        </div>
    </section>

    <div class="publication-container">
        <div class="publication-controls">
            <input
                id="publication-search"
                class="publication-search"
                type="search"
                placeholder="Search by title, author, or venue…"
                aria-label="Search publications"
            />
        </div>

        <div id="publication-list" class="publication-list"></div>

        <p id="publication-empty" class="publication-empty" hidden>No publications match your search.</p>

        <div id="publication-sentinel" class="publication-sentinel"></div>
    </div>
</Layout>

<script define:vars={{ publicationsJson }}>
    const PAGE_SIZE = 20;
    const ALL_PUBLICATIONS = JSON.parse(publicationsJson);

    let filtered = ALL_PUBLICATIONS;
    let offset = 0;
    let lastRenderedYear = null;

    const list = document.getElementById("publication-list");
    const empty = document.getElementById("publication-empty");
    const sentinel = document.getElementById("publication-sentinel");

    function escape(str) {
        return (str ?? "").replace(/[&<>"']/g, (character) =>
            ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[character])
        );
    }

    function truncateAuthors(authors, max = 12) {
        const parts = (authors ?? "").split(",").map((author) => author.trim()).filter(Boolean);
        if (parts.length <= max) return authors ?? "";
        return parts.slice(0, max).join(", ") + ", …";
    }

    function publicationYear(publication) {
        if (!publication?.date) return "Unknown";
        const year = new Date(publication.date).getFullYear();
        return Number.isNaN(year) ? "Unknown" : String(year);
    }

    function publicationLinksHTML(publication, className) {
        return [
            publication.pdf ? `<a href="${escape(publication.pdf)}" class="${className}" target="_blank" rel="noopener noreferrer">PDF →</a>` : "",
            publication.code ? `<a href="${escape(publication.code)}" class="${className}" target="_blank" rel="noopener noreferrer">Code →</a>` : "",
            publication.website ? `<a href="${escape(publication.website)}" class="${className}" target="_blank" rel="noopener noreferrer">Website →</a>` : "",
        ].join("");
    }

    function listHTML(publication) {
        const links = publicationLinksHTML(publication, "publication-list-link");
        const footer = links ? `<div class="publication-list-links">${links}</div>` : "";
        return `
            <article class="publication-list-item publication-result-new">
                <div class="publication-list-content">
                    <span class="publication-list-venue">${escape(publication.venue)}</span>
                    <h3 class="publication-list-title">${escape(publication.title)}</h3>
                    <p class="publication-list-authors">${escape(truncateAuthors(publication.authors))}</p>
                </div>
                ${footer}
            </article>`;
    }

    function renderChunk() {
        const chunk = filtered.slice(offset, offset + PAGE_SIZE);
        if (chunk.length === 0) return;
        const frag = document.createDocumentFragment();
        chunk.forEach((publication) => {
            const year = publicationYear(publication);
            if (year !== lastRenderedYear) {
                const heading = document.createElement("h2");
                heading.className = "publication-year-heading";
                heading.textContent = year;
                frag.appendChild(heading);
                lastRenderedYear = year;
            }
            const listItemContainer = document.createElement("div");
            listItemContainer.innerHTML = listHTML(publication);
            frag.appendChild(listItemContainer.firstElementChild);
        });
        list.appendChild(frag);
        // Trigger fade-in on next frame
        requestAnimationFrame(() => {
            list.querySelectorAll(".publication-result-new").forEach((el) => {
                el.classList.remove("publication-result-new");
            });
        });
        offset += chunk.length;
    }

    function reset() {
        list.innerHTML = "";
        offset = 0;
        lastRenderedYear = null;
        empty.hidden = filtered.length > 0;
        renderChunk();
    }

    // Initial render
    reset();

    // Search
    document.getElementById("publication-search").addEventListener("input", (event) => {
        const searchQuery = event.target.value.trim().toLowerCase();
        if (!searchQuery) {
            filtered = ALL_PUBLICATIONS;
        } else {
            filtered = ALL_PUBLICATIONS.filter(
                (publication) =>
                    (publication.title   ?? "").toLowerCase().includes(searchQuery) ||
                    (publication.authors ?? "").toLowerCase().includes(searchQuery) ||
                    (publication.venue   ?? "").toLowerCase().includes(searchQuery)
            );
        }
        reset();
    });

    // Infinite scroll
    const observer = new IntersectionObserver(
        (entries) => {
            if (entries[0].isIntersecting && offset < filtered.length) {
                renderChunk();
            }
        },
        { rootMargin: "200px" }
    );
    observer.observe(sentinel);
</script>

<style>
    .page-header {
        padding: 8rem 8rem 2rem;
    }
    .publication-container {
        padding: 0 8rem 6rem;
    }

    .publication-controls {
        display: flex;
        align-items: center;
        max-width: 980px;
        margin: 0 auto 1.5rem;
    }
    .publication-search {
        flex: 1;
        min-height: 44px;
        background: var(--bg2);
        border: 1px solid var(--border);
        color: var(--text);
        font-family: "JetBrains Mono", monospace;
        font-size: 0.85rem;
        padding: 0.65rem 1rem;
        outline: none;
        transition: border-color 0.2s, background 0.2s;
    }
    .publication-search::placeholder {
        color: var(--muted);
    }
    .publication-search:focus {
        border-color: rgba(0, 212, 170, 0.5);
        background: var(--bg3);
    }
    /* hide the browser's built-in × button so style stays consistent */
    .publication-search::-webkit-search-cancel-button { display: none; }

    .publication-list {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.8rem;
        max-width: 980px;
        margin: 0 auto;
    }

    @keyframes fadeUp {
        from { opacity: 0; transform: translateY(12px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    :global(.publication-result-new) {
        opacity: 0;
    }
    :global(.publication-list-item:not(.publication-result-new)) {
        animation: fadeUp 0.3s ease both;
    }
    :global(.publication-year-heading) {
        grid-column: 1 / -1;
        margin: 1.5rem 0 0.25rem;
        font-family: "Outfit", sans-serif;
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--text);
        letter-spacing: 0.02em;
        border-bottom: 1px solid var(--border);
        padding-bottom: 0.45rem;
    }
    :global(.publication-year-heading:first-child) {
        margin-top: 0;
    }

    .publication-empty {
        text-align: center;
        padding: 3rem 0;
        color: var(--muted);
        font-family: "JetBrains Mono", monospace;
        font-size: 0.85rem;
    }
    .publication-sentinel {
        height: 1px;
    }

    :global(.publication-list-item) {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: start;
        gap: 1rem;
        background: var(--bg2);
        border: 1px solid var(--border);
        padding: 1.15rem 1.25rem;
        transition:
            border-color 0.25s,
            background 0.25s,
            transform 0.25s;
    }
    :global(.publication-list-item:hover) {
        transform: translateY(-2px);
        border-color: rgba(0, 212, 170, 0.4);
        background: var(--bg3);
    }
    :global(.publication-list-content) {
        min-width: 0;
    }
    :global(.publication-list-venue) {
        display: block;
        margin-bottom: 0.45rem;
        font-family: "JetBrains Mono", monospace;
        font-size: 0.68rem;
        color: var(--accent);
        letter-spacing: 0.08em;
        line-height: 1.3;
        text-transform: uppercase;
    }
    :global(.publication-list-title) {
        margin: 0;
        color: var(--text);
        font-family: "Outfit", sans-serif;
        font-size: 1.02rem;
        font-weight: 600;
        line-height: 1.35;
    }
    :global(.publication-list-authors) {
        margin: 0.55rem 0 0;
        color: var(--muted);
        font-size: 0.84rem;
        line-height: 1.45;
    }
    :global(.publication-list-links) {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 0.8rem;
        padding-top: 0.2rem;
    }
    :global(.publication-list-link) {
        color: var(--muted);
        font-family: "JetBrains Mono", monospace;
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        line-height: 1.4;
        text-decoration: none;
        text-transform: uppercase;
        transition: color 0.2s;
        white-space: nowrap;
    }
    :global(.publication-list-link:hover) {
        color: var(--accent);
    }

    @media (max-width: 900px) {
        .page-header {
            padding: 7rem 3rem 2rem;
        }
        .publication-container {
            padding: 0 3rem 4rem;
        }
    }

    @media (max-width: 600px) {
        .page-header {
            padding: 6rem 1.5rem 1.5rem;
        }
        .publication-container {
            padding: 0 1.5rem 3rem;
        }
        .publication-controls {
            align-items: stretch;
            flex-direction: column;
            max-width: 100%;
        }
        :global(.publication-list-item) {
            grid-template-columns: 1fr;
        }
        :global(.publication-list-links) {
            justify-content: flex-start;
        }
    }
</style>
