---
import publicationsData from "../data/publications.yaml";
import { getSortedPublications, getVisiblePublications, type Publication } from "../utils/publications";
import { projectPublicationTitles } from "../data/project-publications";
import { base } from "../utils/base";

interface Props {
    slug: string;
    title?: string;
}

const { slug, title = "Publications" } = Astro.props as Props;
const allPublications = getSortedPublications(
    getVisiblePublications(publicationsData as Publication[])
);
const publicationByTitle = new Map(
    allPublications.map((publication) => [publication.title, publication])
);
const configuredPublicationTitles = projectPublicationTitles[slug] ?? [];
const projectPublications = configuredPublicationTitles
    .map((publicationTitle) => publicationByTitle.get(publicationTitle))
    .filter(Boolean) as Publication[];

const truncateAuthors = (authors: string, max = 8) => {
    const parts = (authors ?? "")
        .split(",")
        .map((author) => author.trim())
        .filter(Boolean);
    if (parts.length <= max) return authors ?? "";
    return `${parts.slice(0, max).join(", ")}, ...`;
};
const resolvePublicationHref = (href?: string) => (href?.startsWith("/") ? base(href) : href);
---

{
    projectPublications.length > 0 && (
        <section class="project-publications">
            <h2>{title}</h2>
            <div class="publication-list">
                {projectPublications.map((publication) => {
                    const publicationLinks = [
                        publication.pdf ? (
                            <a
                                href={resolvePublicationHref(publication.pdf)}
                                class="publication-list-link"
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                PDF →
                            </a>
                        ) : null,
                        publication.code ? (
                            <a
                                href={publication.code}
                                class="publication-list-link"
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                Code →
                            </a>
                        ) : null,
                        publication.website ? (
                            <a
                                href={resolvePublicationHref(publication.website)}
                                class="publication-list-link"
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                Website →
                            </a>
                        ) : null,
                    ].filter(Boolean);

                    return (
                        <article class="publication-list-item">
                            <div class="publication-list-content">
                                <span class="publication-list-venue">{publication.venue}</span>
                                <h3 class="publication-list-title">{publication.title}</h3>
                                <p class="publication-list-authors">
                                    {truncateAuthors(publication.authors)}
                                </p>
                            </div>
                            {publicationLinks.length > 0 && (
                                <div class="publication-list-links">{publicationLinks}</div>
                            )}
                        </article>
                    );
                })}
            </div>
        </section>
    )
}

<style>
    .project-publications {
        margin-top: 3rem;
    }

    .project-publications h2 {
        font-family: "Spectral", serif;
        color: var(--text);
        margin: 0 0 1.5rem;
        font-weight: 400;
        font-size: 2rem;
    }

    .project-publications .publication-list {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.8rem;
        max-width: 980px;
    }

    .project-publications .publication-list-item {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: start;
        gap: 1rem;
        background: var(--bg2);
        border: 1px solid var(--border);
        padding: 1.15rem 1.25rem;
        transition:
            border-color 0.25s,
            background 0.25s,
            transform 0.25s;
    }

    .project-publications .publication-list-item:hover {
        transform: translateY(-2px);
        border-color: rgba(0, 212, 170, 0.4);
        background: var(--bg3);
    }

    .project-publications .publication-list-content {
        min-width: 0;
    }

    .project-publications .publication-list-venue {
        display: block;
        margin-bottom: 0.45rem;
        font-family: "JetBrains Mono", monospace;
        font-size: 0.68rem;
        color: var(--accent);
        letter-spacing: 0.08em;
        line-height: 1.3;
        text-transform: uppercase;
    }

    .project-publications .publication-list-title {
        margin: 0;
        color: var(--text);
        font-family: "Outfit", sans-serif;
        font-size: 1.02rem;
        font-weight: 600;
        line-height: 1.35;
    }

    .project-publications .publication-list-authors {
        margin: 0.55rem 0 0;
        color: var(--muted);
        font-size: 0.84rem;
        line-height: 1.45;
    }

    .project-publications .publication-list-links {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 0.8rem;
        padding-top: 0.2rem;
    }

    .project-publications .publication-list-link {
        color: var(--muted);
        font-family: "JetBrains Mono", monospace;
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        line-height: 1.4;
        text-decoration: none;
        text-transform: uppercase;
        transition: color 0.2s;
        white-space: nowrap;
    }

    .project-publications .publication-list-link:hover {
        color: var(--accent);
        border-bottom: none;
    }

    @media (max-width: 600px) {
        .project-publications .publication-list-item {
            grid-template-columns: 1fr;
        }

        .project-publications .publication-list-links {
            justify-content: flex-start;
        }
    }
</style>
